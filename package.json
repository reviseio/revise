{
  "name": "revise",
  "version": "3.1.7",
  "reviseBuild": "e75a6f834",
  "description": "Read, edit, and redline Word documents from the command line or TypeScript, with tracked changes, comments, and tools for AI agents.",
  "keywords": [
    "docx",
    "word",
    "cli",
    "tracked-changes",
    "redlines",
    "comments",
    "agent",
    "ai",
    "mcp"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "revise": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/legacy/editor.d.ts",
      "import": "./dist/legacy/editor.js"
    },
    "./editor/full": {
      "types": "./dist/legacy/editor.d.ts",
      "import": "./dist/legacy/editor.js"
    },
    "./server": {
      "types": "./dist/legacy/server.d.ts",
      "import": "./dist/legacy/server.js"
    },
    "./style.css": "./dist/legacy/style.css",
    "./cli-output.schema.json": "./dist/cli-output.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@reviseio/engine": "3.1.7",
    "jszip": "^3.10.1",
    "yjs": "^13.6.27"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.0",
    "canvas": ">=2.11.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "canvas": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://revise.io/developer/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reviseio/revise.git"
  },
  "bugs": {
    "url": "https://github.com/reviseio/revise/issues",
    "email": "sdk@revise.io"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "pack": "npm pack ./dist --pack-destination ."
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.4",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  }
}
